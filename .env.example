# AI Memory Gateway - Environment Example
# Copy this file to .env and fill real values. Do NOT commit .env to GitHub.

NODE_ENV=development
PORT=3010

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rbs_viber
DB_USER=rbs_app
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=10

# Admin security
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
ADMIN_SECONDARY_TOKEN=
ADMIN_CONSOLE_MODE=development
ADMIN_PRODUCTION_HIDE_DEVELOPER_MENUS=false
ADMIN_SHOW_DEVELOPER_MENU=true
ADMIN_ALLOW_URL_DEV_MODE=true
DANGEROUS_ACTION_CONFIRMATION_REQUIRED=true

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=mock
DEFAULT_AI_MODEL=mock-basic

# Backup / restore
DB_BACKUP_DIR=D:\\00. Ai_Memory_System\\backup
DB_BACKUP_GZIP=true
DB_BACKUP_CONFIRMATION_REQUIRED=true
MYSQLDUMP_PATH=mysqldump
MYSQL_CLIENT_PATH=mysql
DB_RESTORE_TARGET_DB=rbs_viber_restore_test
DB_RESTORE_EXECUTION_ENABLED=false

# Import pipeline
IMPORT_BASE_DIR=D:\\00. Ai_Memory_System\\imports
IMPORT_SKIP_DUPLICATES=true

# Workers
SUMMARY_WORKER_BATCH_SIZE=5
SUMMARY_WORKER_LOOP_INTERVAL_MS=60000
DAILY_OPERATION_WORKER_ENABLED=true
